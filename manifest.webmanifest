{
  "id": "/",
  "name": "Synoikon",
  "short_name": "Synoikon",
  "description": "Type a word in any of 21 languages and see the network of words that keep it company, drawn from real text on Wikipedia.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "words/?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#05030f",
  "theme_color": "#05030f",
  "categories": [
    "education",
    "reference",
    "books"
  ],
  "icons": [
    {
      "src": "words/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "words/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "words/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "words/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "words/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Word of the day",
      "short_name": "Today",
      "url": "words/#wotd",
      "icons": [
        {
          "src": "words/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}